NEXT_PUBLIC_SITE_URL=https://signum312.novidades.store
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GTM_ID=

# XPAYMENTS — server only.
XPAYMENTS_API_URL=https://api.xpayments.digital/api/v1

# Store NOVIDADES-BRL (BRL / PIX S2S).
XPAYMENTS_BRL_API_KEY=

# Temporary backward-compatible fallback used only if XPAYMENTS_BRL_API_KEY is empty.
XPAYMENTS_API_KEY=

# Store NOVIDADES-EURO. International checkout will use this key when the EUR rail is enabled.
XPAYMENTS_EURO_API_KEY=

# Shipping charged in BRL cents.
# 0 = free shipping. Example: 1490 = R$ 14,90.
# Required before real PIX charges can be created.
BRL_SHIPPING_CENTS=

# EUR remains hidden until pricing + payment methods are finalized.
NEXT_PUBLIC_EUR_CHECKOUT_ENABLED=false
