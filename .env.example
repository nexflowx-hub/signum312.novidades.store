NEXT_PUBLIC_SITE_URL=https://signum312.novidades.store
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GTM_ID=

# XPAYMENTS API base
XPAYMENTS_API_URL=https://api.xpayments.digital/api/v1

# Server-only API key for the Store NOVIDADES-BRL.
# Never prefix this key with NEXT_PUBLIC_.
XPAYMENTS_BRL_API_KEY=

# Temporary backward-compatible fallback. Prefer XPAYMENTS_BRL_API_KEY.
XPAYMENTS_API_KEY=

# Shipping policy for Brazil, in centavos.
# 0 = free shipping. Example fixed R$ 12,90 = 1290.
# Checkout remains blocked when this variable is absent.
BRL_SHIPPING_CENTS=

# Second currency / Store NOVIDADES-EURO remains disabled until the EUR rail is connected.
NEXT_PUBLIC_EUR_CHECKOUT_ENABLED=false
XPAYMENTS_EURO_API_KEY=
